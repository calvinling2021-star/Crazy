generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ASSET_CEO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals         Deal[]
  agentMessages AgentMessage[]
  uploadedFiles UploadedFile[]
  dealTasks     DealTask[]
}

model Deal {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("ACTIVE")
  description String?
  sector      String?
  stage       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id])
  documents     Document[]
  uploadedFiles UploadedFile[]
  tasks         DealTask[]
  dealProviders DealProvider[]
}

model Document {
  id        String   @id @default(cuid())
  name      String
  url       String?
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model UploadedFile {
  id         String   @id @default(cuid())
  filename   String
  storedName String
  mimeType   String
  sizeBytes  Int
  source     String   @default("upload")
  externalId String?
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([dealId])
  @@index([userId])
  @@index([externalId])
}

// Org-level integrations — one per provider for the whole firm
model Integration {
  id           String    @id @default(cuid())
  provider     String    @unique
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  accountEmail String?
  metadata     String?   // JSON: extra fields per provider (botToken, webhookUrl, etc.)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ServiceProvider {
  id           String         @id @default(cuid())
  name         String
  type         String
  rating       Float?
  contact      String?
  email        String?
  pricing      String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  dealProviders DealProvider[]
}

model AgentConfig {
  id           String   @id @default(cuid())
  agentType    String   @unique
  label        String
  description  String
  systemPrompt String
  updatedAt    DateTime @updatedAt
}

model AgentMessage {
  id        String   @id @default(cuid())
  agentType String
  role      String
  content   String
  sessionId String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model DealTask {
  id         String    @id @default(cuid())
  title      String
  status     String    @default("OPEN")
  priority   String    @default("MEDIUM")
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id])
  dueDate    DateTime?
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([dealId])
}

model DealProvider {
  id         String          @id @default(cuid())
  dealId     String
  deal       Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([dealId, providerId])
  @@index([dealId])
}
