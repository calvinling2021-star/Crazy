# ── Required for Vercel ──────────────────────────────────────────────────────

# Postgres connection string. Get one free from Neon (one-click in Vercel dashboard)
# Example: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=""

# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# For AI agent chat
ANTHROPIC_API_KEY=""

# ── Optional: Gmail / Google Drive ───────────────────────────────────────────
# https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI: https://<your-vercel-domain>/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://<your-vercel-domain>/api/integrations/gmail/callback"
GOOGLE_DRIVE_STORAGE="false"
GOOGLE_DRIVE_FOLDER_ID=""

# ── Optional: Outlook / Microsoft ────────────────────────────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="https://<your-vercel-domain>/api/integrations/outlook/callback"

# ── Optional: Zoom ───────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="https://<your-vercel-domain>/api/integrations/zoom/callback"
