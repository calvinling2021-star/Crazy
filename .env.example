# Optional API keys — leave blank to fall back to free / built-in equivalents.
# Set in .env (which is gitignored) before running ./run.sh or docker compose.

# Hunter.io email finder (https://hunter.io)
HUNTER_API_KEY=

# NeverBounce email verifier (https://neverbounce.com)
# When unset, pipeline.verify falls back to a built-in MX + SMTP RCPT probe.
NEVERBOUNCE_API_KEY=

# Set to "0" to skip the SMTP RCPT probe in pipeline.verify
SMTP_VERIFY=1

# --- Capital Trust Center / VCOP (the /capital app + MCP server) ---
# Stripe RESTRICTED, READ-ONLY key (rk_... or sk_...). When set, the /capital dashboard and
# the MCP server compute verified metrics + credit score from your live Stripe data instead
# of the built-in demo company. READ-ONLY by design — the app never writes or moves money.
STRIPE_SECRET_KEY=
# Optional display overrides for the connected company
CDP_COMPANY_NAME=
CDP_INCORP_DATE=

# Public base URL of the deployment — used for absolute OG / share-card image URLs.
# e.g. https://attestly.vercel.app or your custom domain. Defaults to the legacy domain.
NEXT_PUBLIC_SITE_URL=
